{
  "databases": [
    {"name": "orders-primary", "host": "orders-db.example.com", "port": 5432, "dbName": "orders", "username": "orders_backend", "password": "<orders backend password>", "sslMode": "verify-full"},
    {"name": "reports-primary", "host": "reports-db.example.com", "port": 5432, "dbName": "reports", "username": "reports_backend", "password": "<reports backend password>", "sslMode": "verify-full"}
  ],
  "clusters": {"orders": {"primary": "orders-primary"}, "reports": {"primary": "reports-primary"}},
  "logicalDatabases": {"orders": {"cluster": "orders"}, "reports": {"cluster": "reports"}},
  "proxy": {
    "listenerAddress": "0.0.0.0:15432",
    "passwordAuthEnabled": true,
    "tlsRequired": true,
    "tlsCertFile": "/etc/pg-proxy/server.crt",
    "tlsKeyFile": "/etc/pg-proxy/server.key"
  },
  "users": [
    {"staticCredentials": {"username": "alice", "password": "<Alice client password>"}, "databases": ["orders"]},
    {"staticCredentials": {"username": "bob", "scramSHA256": "<Bob SCRAM verifier>"}, "databases": ["orders", "reports"]}
  ]
}
